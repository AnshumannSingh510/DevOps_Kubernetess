# Copy this file to ".env" (same folder) and fill in real values locally.
# ".env" is git-ignored and must NEVER be committed.

# --- SonarQube ---
SONAR_DB_PASSWORD=change-me
SONAR_TOKEN=paste-a-generated-sonarqube-token-here
SONAR_HOST_URL=http://localhost:9000

# --- Docker Hub (or another registry) ---
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=paste-a-dockerhub-access-token-here
DOCKER_IMAGE_NAME=your-dockerhub-username/devops-demo

# --- GitHub ---
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=paste-a-github-personal-access-token-here
GITOPS_REPO_URL=https://github.com/your-username/devops-kubernetes-project.git

# --- Grafana (Kubernetes deployment) ---
GRAFANA_ADMIN_PASSWORD=change-me

# NOTE: In Jenkins, these values are NOT read from this file. They are stored
# as Jenkins Credentials (Manage Jenkins -> Credentials) and injected into the
# pipeline with withCredentials(...). This file exists so a human running
# scripts locally (build.ps1 / deploy.ps1) has one place to configure values,
# without ever hardcoding secrets into the repo.
