      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"devops-demo\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
